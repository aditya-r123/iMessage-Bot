# Copy this file to .env and fill in your values.
# .env takes precedence over shell-exported env vars.

# Your OpenAI API key. Optional if you've already `export OPENAI_API_KEY=...` in your shell.
OPENAI_API_KEY=sk-...

# Optional: override the system prompts. Leave blank to use the defaults in messaging.py.
# Use {name} as a placeholder — it's substituted with the contact name (DM) or group name (group).
CUSTOM_DM_PROMPT=""
CUSTOM_GROUP_PROMPT=""

# How strongly to bias the model toward multiple short messages vs one longer message.
# 0.0 = always one message. 0.5 = neutral. 1.0 = always split into many short ones.
MULTI_MESSAGE_WEIGHT=