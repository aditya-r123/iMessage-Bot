# Copy this file to .env and fill in your values.
# .env takes precedence over shell-exported env vars.

# Your OpenAI API key. Optional if you've already `export OPENAI_API_KEY=...` in your shell.
OPENAI_API_KEY=sk-...

# System prompt for DM replies. Must include the {contact_name} placeholder.
DM_SYSTEM_PROMPT=""

# System prompt for group-chat replies. Must include the {group_name} placeholder.
GROUP_SYSTEM_PROMPT=""
